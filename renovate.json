{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "packageRules": [
    {
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": true,
      "matchPackageNames": [
        "org.springframework.boot:*",
        "org.mybatis.spring.boot:*",
        "org.springdoc:*"
      ],
      "groupName": "Spring Boot"
    }
  ]
}